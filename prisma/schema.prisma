generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This is the page containing the schema we send to Supabase.
/// Changes here update the database structure.

/// This model contains row level security and requires additional setup for migrations.
/// Visit https://pris.ly/d/row-level-security for more info.
model User {
  id         String   @id
  email      String?  @unique
  name       String?
  image      String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  films      film[]

  @@map("users")
}

model film {
  id                          BigInt       @id @default(autoincrement())
  ownerId                     String?
  owner                       User?        @relation(fields: [ownerId], references: [id])
  title                       String
  originalTitle               String?
  year                        Int
  runtime                     Int
  genre                       String
  format                      String
  countryProduction           String
  languages                   String
  completionDate              DateTime?
  worldPremiereStatus         String?
  internationalPremiereStatus String?
  previousFestivalSelections  String?
  director                    String
  productionCompany           String
  logline                     String
  shortSynopsis               String
  created_at                  DateTime     @default(now()) @db.Timestamptz(6)
  allVersions                 AllVersion[]

  @@index([ownerId])
  @@map("films")
}

model AllVersion {
  id        BigInt @id @default(autoincrement())
  filmId    BigInt
  film      film   @relation(fields: [filmId], references: [id], onDelete: Cascade)

  version Int
  title   String

  logline           String?
  shortSynopsis     String?
  longSynopsis      String?
  directorStatement String?
  producerStatement String?

  cast             Json?
  crew             Json?
  technicalSpecs   Json?
  festivals        Json?
  awards           Json?
  stills           Json?
  poster           Json?
  budget           Json?
  financing        Json?

  trailerUrl String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([filmId, version])
  @@index([filmId])
  @@map("all_versions")
}
